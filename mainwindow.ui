    <property name="styleSheet">
     <string notr="true">QLineEdit {
    font-size: 14px;
    padding: 5px 10px;
    border: 2px solid #ccc;
    border-radius: 5px;
    background-color: #f9f9f9;
    color: #333;
}

QLineEdit:focus {
    border-color: #4A90E2; /* Couleur de la bordure quand le champ est sélectionné */
    background-color: #fff;
}

QLineEdit::placeholder {
    color: #aaa; /* Couleur du texte placeholder */
    font-style: italic;
}


</string>
